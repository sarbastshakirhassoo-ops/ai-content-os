{
  "name": "universal-brain",
  "version": "1.0.0",
  "private": true,
  "description": "Privates AI Intelligence System — LLM, Internet-Recherche, Memory",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "check": "node scripts/check-boundaries.mjs",
    "verify": "npm run check && npm run typecheck && npm run build",
    "test": "npm run test:planner && npm run test:confidence && npm run test:memory && npm run test:voice && npm run test:research && npm run test:extract && npm run test:provider",
    "test:planner": "node --experimental-strip-types --no-warnings scripts/test-planner-filter.ts",
    "test:research": "node --experimental-strip-types --no-warnings scripts/test-research.ts",
    "test:extract": "node --experimental-strip-types --no-warnings scripts/test-extract.ts",
    "test:provider": "bash scripts/test-provider.sh",
    "test:confidence": "node --experimental-strip-types --no-warnings scripts/test-confidence.ts",
    "test:memory": "node --experimental-strip-types --no-warnings scripts/test-memory.ts",
    "test:voice": "node --experimental-strip-types --no-warnings scripts/test-voice.ts",
    "test:acceptance": "node --env-file-if-exists=.env.local --experimental-strip-types --no-warnings scripts/test-acceptance.ts"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "@xyflow/react": "^12.0.0",
    "linkedom": "^0.18.0",
    "next": "^16.3.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.4.0"
  }
}
