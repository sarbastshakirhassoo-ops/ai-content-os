# ─────────────────────────────────────────────────────────────────────────────
# Universal Brain — Environment Variables
# Kopieren: cp .env.example .env.local   (.env.local NIEMALS committen)
#
# Stand: Roadmap-Schritt 1. Es wird noch keine dieser Variablen gelesen.
# Sie werden ab Schritt 2 (Provider-Schicht) schrittweise aktiviert.
# ─────────────────────────────────────────────────────────────────────────────

# ── LLM Provider (Schritt 2) ─────────────────────────────────────────────────
# Welcher Provider primär genutzt wird: gemini | ollama
BRAIN_LLM_PROVIDER="gemini"

# Google AI Studio, kostenloser Tier, keine Kreditkarte
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Ollama lokal — kein Key nötig, nur die Adresse
# Installation: https://ollama.com   Modell z.B.: ollama pull llama3.1:8b
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.1:8b"

# ── Research (Schritt 4 und 5) ───────────────────────────────────────────────
# Alle Standardquellen laufen ohne Key: Google News RSS, Hacker News,
# Reddit, Product Hunt, Wikipedia, EZB, Eurostat, World Bank, SEC EDGAR, arXiv.
#
# Optionale kostenlose Keys für zusätzliche Primärquellen:
FRED_API_KEY=
DESTATIS_USERNAME=
DESTATIS_PASSWORD=

# SEC EDGAR verlangt einen identifizierenden User-Agent
SEC_USER_AGENT="universal-brain your-email@example.com"

# ── Memory (Schritt 6) ───────────────────────────────────────────────────────
BRAIN_DB_PATH="./data/brain.db"

# ── Kostenpflichtig, bewusst NICHT gesetzt ───────────────────────────────────
# Erst nach dem Engpass-Verfahren aus docs/BRAIN-V1-PLAN.md Abschnitt 8.
# BRAVE_SEARCH_API_KEY=
# TAVILY_API_KEY=

# ── Research (Schritt 4) ─────────────────────────────────────────────────────
# ALLE 13 Quellen laufen ohne Key. Es gibt hier nichts einzutragen,
# damit die Recherche funktioniert.

# Kontaktadresse im User-Agent. SEC, Crossref und OpenAlex verlangen oder
# belohnen sie mit höheren Limits.
RESEARCH_CONTACT=

# Sprache und Land für Google News. Standard: de:DE
RESEARCH_NEWS_LOCALE="de:DE"

# Sprachversion der Wikipedia. Standard: de
RESEARCH_WIKI_LANG="de"

# Höchstzahl gleichzeitig befragter Quellen je Anfrage. Standard: 5
RESEARCH_MAX_SOURCES=5

# NUR FÜR TESTS: lässt genannte Quellen absichtlich scheitern.
RESEARCH_FAIL_SOURCES=
